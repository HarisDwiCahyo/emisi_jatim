# Normalisasi akhir baris: simpan LF di repo, hilangkan warning CRLF
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.geojson text eol=lf

# File biner (jangan diutak-atik line-ending-nya)
*.tif   binary
*.tiff  binary
*.shp   binary
*.dbf   binary
*.shx   binary
*.cpg   binary
*.prj   binary
*.jpeg  binary
*.jpg   binary
*.png   binary
